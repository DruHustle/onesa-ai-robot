{
  "name": "onesa-robot-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "start": "node server.mjs",
    "lint": "node --check public/app.js && node --check public/inspection.js && node --check public/humanoid.js && node --check server.mjs && node --check api/gateway.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0",
    "typescript": "5.9.3",
    "@types/node": "26.6.5",
    "openapi-typescript": "7.13.0",
    "minimatch": "file:vendor/onesa-robot-minimatch-callable-1.0.0.tgz"
  },
  "overrides": {
    "@redocly/openapi-core@1.34.20": {"minimatch": "$minimatch"}
  }
}
