{
  "name": "onesa-robot-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "lint": "node --check public/app.js && node --check server.mjs && node --check api/gateway.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0"
  }
}
