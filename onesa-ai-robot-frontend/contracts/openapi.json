{
  "components": {
    "schemas": {
      "ActionResponse": {
        "properties": {
          "physical_actuation": {
            "const": false,
            "default": false,
            "title": "Physical Actuation",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ActionResponse",
        "type": "object"
      },
      "Capabilities": {
        "properties": {
          "camera": {
            "const": "not_connected",
            "default": "not_connected",
            "title": "Camera",
            "type": "string"
          },
          "ros2": {
            "const": "not_connected",
            "default": "not_connected",
            "title": "Ros2",
            "type": "string"
          },
          "stt": {
            "const": "not_configured",
            "default": "not_configured",
            "title": "Stt",
            "type": "string"
          },
          "tts": {
            "const": "not_configured",
            "default": "not_configured",
            "title": "Tts",
            "type": "string"
          },
          "vla": {
            "const": "not_configured",
            "default": "not_configured",
            "title": "Vla",
            "type": "string"
          },
          "vlm": {
            "const": "not_configured",
            "default": "not_configured",
            "title": "Vlm",
            "type": "string"
          }
        },
        "title": "Capabilities",
        "type": "object"
      },
      "Confirmation": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "Confirmation",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Login": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "name",
          "password"
        ],
        "title": "Login",
        "type": "object"
      },
      "Proposal": {
        "additionalProperties": false,
        "properties": {
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "duration_seconds": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Duration Seconds",
            "type": "number"
          },
          "issued_at": {
            "title": "Issued At",
            "type": "number"
          },
          "target_radians": {
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Target Radians",
            "type": "number"
          }
        },
        "required": [
          "command_id",
          "issued_at",
          "target_radians",
          "duration_seconds"
        ],
        "title": "Proposal",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "csrf": {
            "title": "Csrf",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "csrf",
          "name"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "StatusResponse": {
        "properties": {
          "active_task": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Task"
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          },
          "mode": {
            "const": "simulation",
            "title": "Mode",
            "type": "string"
          },
          "operator": {
            "title": "Operator",
            "type": "string"
          },
          "physical_actuation": {
            "const": false,
            "title": "Physical Actuation",
            "type": "boolean"
          },
          "position_radians": {
            "title": "Position Radians",
            "type": "number"
          },
          "stopped": {
            "title": "Stopped",
            "type": "boolean"
          }
        },
        "required": [
          "mode",
          "physical_actuation",
          "stopped",
          "position_radians",
          "operator",
          "active_task",
          "capabilities"
        ],
        "title": "StatusResponse",
        "type": "object"
      },
      "TaskList": {
        "properties": {
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/TaskSummary"
            },
            "title": "Tasks",
            "type": "array"
          }
        },
        "required": [
          "tasks"
        ],
        "title": "TaskList",
        "type": "object"
      },
      "TaskResponse": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "state": {
            "enum": [
              "proposed",
              "running"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "state"
        ],
        "title": "TaskResponse",
        "type": "object"
      },
      "TaskSummary": {
        "properties": {
          "created": {
            "title": "Created",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "position": {
            "title": "Position",
            "type": "number"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "state": {
            "enum": [
              "proposed",
              "running",
              "completed",
              "cancelled"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "state",
          "reason",
          "created",
          "position"
        ],
        "title": "TaskSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Onesa Robot Simulation API",
