# Server only. Physical actuation is unavailable, regardless of model proposals.
ROBOT_PUBLIC_ORIGIN=http://localhost:3431
ROBOT_OPERATOR_NAME=operator
# Generate privately: python -m robot_api.security
ROBOT_OPERATOR_PASSWORD_HASH=REPLACE_WITH_GENERATED_SCRYPT_HASH
ROBOT_DATABASE_PATH=storage/robot.sqlite3
ROBOT_ACTUATION_ENABLED=false
ROBOT_SESSION_SECONDS=900
ROBOT_HEARTBEAT_SECONDS=3
PORT=8431

# local | staging | production; never claim ephemeral data is durable
ROBOT_DEPLOYMENT_ENVIRONMENT=local
ROBOT_STORAGE_MODE=persistent
# Optional outbound synthetic device telemetry; store the independent SHA256 hash only
ROBOT_EDGE_DEVICE_ID=
ROBOT_EDGE_TOKEN_SHA256=

# Staging-only remote durable task journal (select ROBOT_STORAGE_MODE=turso).
# Sessions, stop authority and watchdog remain process-local; no disk is needed.
ROBOT_TURSO_DATABASE_URL=
ROBOT_TURSO_AUTH_TOKEN=
