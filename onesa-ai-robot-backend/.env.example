# Server only. Physical actuation is unavailable, regardless of model proposals.
ROBOT_PUBLIC_ORIGIN=http://localhost:3431
ROBOT_OPERATOR_NAME=operator
# Generate privately: python -m robot_api.security
ROBOT_OPERATOR_PASSWORD_HASH=REPLACE_WITH_GENERATED_SCRYPT_HASH
ROBOT_DATABASE_PATH=storage/robot.sqlite3
ROBOT_ACTUATION_ENABLED=false
ROBOT_SESSION_SECONDS=900
ROBOT_HEARTBEAT_SECONDS=3
PORT=8431
